// NexusMart measures, PART 2 (fixed time measures + the remaining measures).
// Run in DAX query view, then Update model with changes (or Add/Overwrite measure links).
DEFINE
MEASURE FactSales[Latest Month] =
    VAR d = MAX ( FactSales[date_key] )
    RETURN IF ( ISBLANK ( d ), BLANK (), DATE ( INT ( d / 10000 ), MOD ( INT ( d / 100 ), 100 ), 1 ) )
MEASURE FactSales[Net Revenue PM] =
    VAR m = [Latest Month]
    RETURN CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
MEASURE FactSales[Net Revenue MoM %] =
    VAR m = [Latest Month]
    VAR cur = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = m )
    VAR prev = CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
    RETURN DIVIDE ( cur - prev, prev )
MEASURE FactSales[NMV PM] =
    VAR m = [Latest Month]
    RETURN CALCULATE ( [NMV], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
MEASURE FactSales[NMV MoM %] =
    VAR m = [Latest Month]
    VAR cur = CALCULATE ( [NMV], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = m )
    VAR prev = CALCULATE ( [NMV], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
    RETURN DIVIDE ( cur - prev, prev )
MEASURE FactSales[Orders PM] =
    VAR m = [Latest Month]
    RETURN CALCULATE ( [Orders], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
MEASURE FactSales[Orders MoM %] =
    VAR m = [Latest Month]
    VAR cur = CALCULATE ( [Orders], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = m )
    VAR prev = CALCULATE ( [Orders], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = EDATE ( m, -1 ) )
    RETURN DIVIDE ( cur - prev, prev )
MEASURE FactSales[Latest MoM % Net Revenue] = [Net Revenue MoM %]
MEASURE FactSales[Latest MoM % NMV] = [NMV MoM %]
MEASURE FactSales[Latest MoM % Orders] = [Orders MoM %]
MEASURE FactSales[Net Revenue 3M Avg] =
    VAR m = [Latest Month]
    VAR months = FILTER ( ALL ( DimDate[month_start_date] ), DimDate[month_start_date] > EDATE ( m, -3 ) && DimDate[month_start_date] <= m )
    RETURN AVERAGEX ( months, VAR v = DimDate[month_start_date] RETURN CALCULATE ( [Net Revenue], REMOVEFILTERS ( DimDate ), DimDate[month_start_date] = v ) )
MEASURE FactSales[Days With Sales] = COUNTROWS ( FILTER ( VALUES ( DimDate[full_date] ), [Gross Sales] > 0 ) )
MEASURE FactSales[Avg Daily NMV] = DIVIDE ( [NMV], [Days With Sales] )
MEASURE FactSales[Avg Daily Orders] = DIVIDE ( [Orders], [Days With Sales] )
MEASURE FactSales[Avg Daily NMV Regular Days] = CALCULATE ( [Avg Daily NMV], DimDate[festival] = "Regular Day" )
MEASURE FactSales[Festival Lift %] = DIVIDE ( [Avg Daily NMV], [Avg Daily NMV Regular Days] ) - 1
MEASURE FactSales[New Customers] = CALCULATE ( DISTINCTCOUNT ( FactSales[customer_key] ), FactSales[is_first_order] = TRUE (), FactSales[customer_key] <> -1 )
MEASURE FactSales[Returning Customers] = [Active Customers] - [New Customers]
MEASURE FactSales[Repeat Customers] = CALCULATE ( DISTINCTCOUNT ( FactSales[customer_key] ), FactSales[is_cancelled] = FALSE (), DimCustomer[rfm_frequency] >= 2 )
MEASURE FactSales[Repeat Purchase Rate] = DIVIDE ( [Repeat Customers], [Active Customers] )
MEASURE FactSales[Observed CLV] = DIVIDE ( [Net Revenue], [Active Customers] )
MEASURE FactSales[Observed CLV Margin] = DIVIDE ( [Margin], [Active Customers] )
MEASURE FactSales[Orders per Customer] = DIVIDE ( [Orders], [Active Customers] )
MEASURE FactSales[On-Time Lines] = CALCULATE ( COUNTROWS ( FactSales ), FactSales[on_time_status] = "On Time" )
MEASURE FactSales[Late Lines] = CALCULATE ( COUNTROWS ( FactSales ), FactSales[on_time_status] = "Late" )
MEASURE FactSales[On-Time Delivery Rate] = DIVIDE ( [On-Time Lines], [On-Time Lines] + [Late Lines] )
MEASURE FactSales[Avg Shipping Days] = CALCULATE ( AVERAGE ( FactSales[shipping_days] ), FactSales[is_delivered] = TRUE () )
MEASURE FactSales[Avg Seller Quality Score] = AVERAGE ( DimSeller[quality_score] )
MEASURE FactSales[Top 5 Cities NMV Share] =
    VAR top5 = TOPN ( 5, FILTER ( ALLSELECTED ( DimLocation[city] ), DimLocation[city] <> "Unknown" ), [NMV], DESC )
    RETURN DIVIDE ( SUMX ( top5, [NMV] ), CALCULATE ( [NMV], ALLSELECTED ( DimLocation ) ) )

EVALUATE
ROW (
    "Latest Month", [Latest Month],
    "Net Revenue MoM %", [Net Revenue MoM %],
    "Latest MoM % Net Revenue", [Latest MoM % Net Revenue],
    "Orders MoM %", [Orders MoM %],
    "Net Revenue 3M Avg", [Net Revenue 3M Avg],
    "Festival Lift %", [Festival Lift %],
    "Repeat Purchase Rate", [Repeat Purchase Rate],
    "On-Time Delivery Rate", [On-Time Delivery Rate],
    "Top 5 Cities NMV Share", [Top 5 Cities NMV Share]
)
